{
  "name": "tram-sac-cam-xuc",
  "version": "1.0.0",
  "private": true,
  "description": "Trạm Sạc Cảm Xúc của LHP và TDT hjhj — Web chat chữa lành, chạy bằng Ollama local hoặc Groq/OpenRouter trên cloud.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",

    "preflight": "node tools/preflight.mjs",
    "verify": "node tools/preflight.mjs --full",
    "check:conflicts": "node tools/check-conflicts.mjs",
    "fix:conflicts": "node tools/fix-conflicts.mjs",
    "smoke": "node tools/smoke-test.mjs",
    "hooks:install": "node tools/install-git-hooks.mjs",
    "hooks:remove": "node tools/install-git-hooks.mjs --remove"
  },
  "dependencies": {
    "@ai-sdk/openai": "0.0.72",
    "@radix-ui/react-slot": "^1.1.0",
    "ai": "3.4.33",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "ollama-ai-provider": "0.16.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
