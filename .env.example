# =============================================================================
#  CẤU HÌNH BESTIE — copy file này thành `.env.local` rồi điền
# =============================================================================
#
#  Có HAI chế độ chạy, chọn MỘT:
#
#    A. CLOUD (khuyên dùng khi deploy lên Vercel)
#       → cần API key, nhanh, không cần máy khoẻ. Nội dung tin nhắn được gửi
#         tới nhà cung cấp model để sinh câu trả lời.
#
#    B. LOCAL (Ollama trên máy bạn)
#       → không cần key, không cần internet, không dữ liệu nào rời máy.
#         Chỉ dùng được khi chạy trên chính máy đó (không dùng được trên Vercel).
#
#  Cách chọn: đặt LLM_PROVIDER. Nếu bỏ trống, app tự đoán theo thứ tự
#  Groq → OpenRouter → OpenAI-compatible → Ollama.
#
#  ⚠️  KHI DEPLOY LÊN VERCEL: không tạo file `.env.local` ở đó. Thay vào đó vào
#      Vercel → Project → Settings → Environment Variables, thêm từng biến rồi
#      **Redeploy** (biến môi trường chỉ được nạp lúc build/khởi động).
# =============================================================================


# -----------------------------------------------------------------------------
#  CHỌN NHÀ CUNG CẤP
# -----------------------------------------------------------------------------
# groq | openrouter | openai-compatible | ollama   (bỏ trống = tự đoán)
LLM_PROVIDER=groq


# =============================================================================
#  A. CLOUD
# =============================================================================

# --- A1. Groq (khuyên dùng: nhanh nhất, free tier hào phóng) -------------------
# Lấy key tại: https://console.groq.com/keys  (đăng nhập bằng Google/GitHub)
# Key có dạng: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
# Model mặc định: openai/gpt-oss-20b — model Production, có trên free tier,
# và là model chính thức được Groq khuyến nghị thay cho llama-3.1-8b-instant.
#
# ⚠️  CẢNH BÁO DEPRECATION (kiểm tra ngày 16/09/2026):
#     Groq đã NGỪNG cung cấp cho free + developer tier hai model sau (từ 16/08/2026):
#       llama-3.1-8b-instant     → thay bằng openai/gpt-oss-20b
#       llama-3.3-70b-versatile  → thay bằng openai/gpt-oss-120b hoặc qwen/qwen3.6-27b
#     Nếu bạn copy cấu hình từ hướng dẫn cũ và dùng chúng, tin nhắn đầu tiên sẽ
#     lỗi "model_decommissioned" / không tìm thấy model.
#     Luôn kiểm tra lại trước khi đổi model:
#       curl -s https://console.groq.com/docs/deprecations.md
#
# Các lựa chọn hiện có trên Groq (hạn mức free tier ước tính: 30 RPM / 1K RPD /
# 8K TPM / 200K TPD cho nhóm gpt-oss và qwen3.8):
#   openai/gpt-oss-20b           → mặc định. Nhanh (~1000 tps), rẻ, có free tier
#   openai/gpt-oss-120b          → thông minh hơn, cùng mức hạn mức free
#   openai/gpt-oss-safeguard-20b → bản thiên về an toàn/kiểm duyệt nội dung
#   qwen/qwen3.8-27b             → đa ngữ tốt (nhóm Preview, có thể bị ngừng)
#   groq/compound                → hệ thống có sẵn công cụ tìm kiếm web
#
# Kiểm tra hạn mức CHÍNH XÁC cho tài khoản của bạn (nguồn duy nhất đúng):
#   https://console.groq.com/settings/limits
GROQ_MODEL=openai/gpt-oss-20b
# Chỉ dùng khi test hoặc khi bạn có proxy riêng. Bỏ trống để dùng mặc định của Groq.
# GROQ_BASE_URL=http://127.0.0.1:11502/v1

# --- A2. OpenRouter (nhiều model, có model miễn phí) --------------------------
# Lấy key tại: https://openrouter.ai/keys
# Key có dạng: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=
# Tên model theo đúng định dạng của OpenRouter.
# Mặc định qwen/qwen-2.5-7b-instruct: còn hoạt động (kiểm tra 16/09/2026),
# context 32K, giá ~$0.10 input / $0.20 output cho mỗi 1M token.
#
# ⚠️  Danh sách model ":free" THAY ĐỔI LIÊN TỤC — các id hay gặp trong hướng dẫn
#     cũ (google/gemma-2-9b-it:free, deepseek/deepseek-chat-v3.1:free…) đã không
#     còn tồn tại. Đừng tin danh sách trong bất kỳ tài liệu nào, kể cả file này —
#     hãy lấy danh sách SỐNG (API này công khai, không cần key):
#
#       curl -s https://openrouter.ai/api/v1/models | python3 -c \
#         "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data'] \
#          if m['pricing']['prompt']=='0' and m['pricing']['completion']=='0']"
#
#     (ngày 16/09/2026 có 24 model miễn phí, ví dụ: google/gemma-4-31b-it:free,
#      z-ai/glm-5.2:free, nvidia/nemotron-3.5-lightning:free, openrouter/free)
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Hai biến dưới đây OpenRouter dùng để xếp hạng ứng dụng — không bắt buộc,
# nhưng bạn sẽ thấy tên app mình trên dashboard của họ.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# --- A3. Bất kỳ API nào theo chuẩn OpenAI (Together, DeepInfra, vLLM, LM Studio…) ---
# Đặt LLM_PROVIDER=openai-compatible rồi điền 3 biến này.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# =============================================================================
#  B. LOCAL (Ollama)
# =============================================================================
# Đặt LLM_PROVIDER=ollama để dùng chế độ này.
# Key không cần thiết — Ollama chạy trên máy bạn.

# Địa chỉ Ollama API. LƯU Ý: có hậu tố /api ở cuối (không phải /v1).
OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Model dùng để tâm sự:
#   qwen2.5:7b    → mặc định, tiếng Việt khá tốt, nhẹ (~5GB RAM)
#   llama3.1:8b   → thay thế tương đương
#   qwen2.5:3b    → cho máy yếu, thấu cảm nông hơn
OLLAMA_MODEL=qwen2.5:7b

# Giữ model trong RAM bao lâu sau lần dùng cuối (giúp lần chat sau không phải
# chờ load lại). Đây là biến DUY NHẤT của Ollama không dùng được trên cloud.
OLLAMA_KEEP_ALIVE=30m

# Cửa sổ ngữ cảnh (độ "nhớ" của Bestie). Mặc định Ollama chỉ 2048 → quá ngắn.
OLLAMA_NUM_CTX=8192


# =============================================================================
#  CHUNG CHO MỌI NHÀ CUNG CẤP — "tính khí" của Bestie và giới hạn tài nguyên
# =============================================================================

# Nhiệt độ (0 = lý trí, 1 = bay bổng). Bestie cần mềm mại nên để 0.85.
LLM_TEMPERATURE=0.85

# Độ dài tối đa mỗi câu trả lời (token). Prompt yêu cầu nhắn tin ngắn → 512 đủ.
LLM_MAX_TOKENS=512

# Thời gian chờ tối đa khi kiểm tra sức khoẻ provider (ms).
# Tăng lên 5000 nếu mạng tới Groq/OpenRouter chậm.
HEALTH_TIMEOUT_MS=2500


# =============================================================================
#  RATE LIMIT — BẮT BUỘC NÊN BẬT KHI ỨNG DỤNG ĐÃ CÔNG KHAI
# =============================================================================
# Số request tối đa cho mỗi IP trong mỗi cửa sổ thời gian.
#
# ⚠️  ĐỌC TRƯỚC KHI CHỌN CON SỐ — nhà mạng Việt Nam dùng CGNAT rất nhiều, nghĩa
#     là hàng chục/hàng trăm người thật có thể dùng CHUNG một IP công cộng. Đặt
#     quá thấp thì một người nhắn nhiều sẽ chặn cả xóm. Khuyến nghị khi đã public:
#       20  → an toàn cho demo, dễ chặn nhầm người dùng chung IP
#       60  → cân bằng, phù hợp đa số (mặc định nên dùng khi mở cho người ngoài)
#       200 → thoáng, chỉ chặn bot thô
RATE_LIMIT_MAX=20

# Độ dài cửa sổ, tính bằng giây.
RATE_LIMIT_WINDOW=60

# Đặt =1 để TẮT rate limit (chỉ nên dùng khi phát triển ở máy, tránh tự chặn mình).
# RATE_LIMIT_DISABLED=1

# Danh sách IP được BỎ QUA rate limit, phân tách bằng dấu phẩy. Dùng để bạn tự
# kiểm thử thoải mái mà không chặn chính mình. Đây là công cụ vận hành, KHÔNG
# phải cơ chế xác thực (IP có thể đổi). Xem IP hiện tại: `curl ifconfig.me`
# RATE_LIMIT_BYPASS_IPS=203.0.113.99

# --- Hạn mức NGÀY cho toàn hệ thống (0 = tắt) --------------------------------
# Đây mới là lớp bảo vệ QUOTA THẬT, và cũng là con số đáng quan tâm nhất:
# giới hạn theo IP không cứu được bạn khi 1.000 người khác IP cùng đốt quota.
# Groq free tier có trần token/ngày ở cấp TỔ CHỨC (ví dụ 200K TPD ≈ chỉ khoảng
# 50–130 lượt chat/ngày cho cả app — xem DEPLOYMENT_GUIDE.md §5.1).
#
# Đặt = số lượt chat tối đa mỗi ngày cho CẢ app. Ví dụ 100 nghĩa là: hết 100 lượt
# thì mọi người nhận thông báo "trạm đã sạc hết pin hôm nay" (thay vì để Groq trả
# lỗi khó hiểu). Mốc reset là 00:00 UTC.
#
# ⚠️  CHỈ HOẠT ĐỘNG KHI CÓ UPSTASH (bộ đếm trong RAM không chia sẻ được giữa các
#     instance serverless). Nếu bật mà thiếu Upstash, app sẽ ghi log cảnh báo và bỏ qua.
GLOBAL_DAILY_MAX=0

# --- Upstash Redis: rate limit CHÍNH XÁC trên toàn hệ thống -------------------
# ⚠️  Vercel có thể chạy nhiều instance song song, mỗi instance có RAM riêng.
#     Nếu KHÔNG cấu hình Upstash, rate limit chỉ là "best-effort" theo từng
#     instance (vẫn chặn được spam từ một tab, nhưng không phải hàng rào cứng).
#     Và GLOBAL_DAILY_MAX ở trên sẽ không hoạt động.
#
# Cách tạo (miễn phí): https://console.upstash.com → Create Database → chọn region
# Publishable key KHÔNG dùng được ở đây; cần REST URL và REST TOKEN:
#   UPSTASH_REDIS_REST_URL=https://xxxx-12345.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# =============================================================================
#  CORS — thường KHÔNG cần
# =============================================================================
# Frontend gọi API bằng đường dẫn tương đối `/api/chat`, cùng origin với trang
# web ⇒ KHÔNG có lỗi CORS. Chỉ điền biến này khi bạn gọi API từ một website khác
# (ví dụ nhúng chat vào blog riêng).
#
# Ngăn cách bằng dấu phẩy, so khớp CHÍNH XÁC (không hỗ trợ ký tự đại diện).
# TUYỆT ĐỐI không đặt `*` cho ứng dụng này.
ALLOWED_ORIGINS=
